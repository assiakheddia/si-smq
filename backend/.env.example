APP_ENV=development
DEBUG=false

POSTGRES_USER=smq_user
POSTGRES_PASSWORD=smq_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=si_smq

SECRET_KEY=changez_moi_avec_openssl_rand_hex_32_minimum_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_DEFAULT_PASSWORD=changeme

# Google OAuth — optionnel, à remplir depuis Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173

# MinIO — stockage des documents (GED)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTS=si-smq-documents
MINIO_USE_SSL=false

# Moteur Analytique IA — optionnel. Si vide, bascule automatiquement
# sur l'évaluation locale (aucun appel réseau, aucune fonctionnalité bloquée).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
